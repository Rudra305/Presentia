{
    "name": "presentia",
    "main": "expo-router/entry",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "lint": "expo lint",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.{json,md,js,ts}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.{json,md,js,ts}\"",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "build:apk": "cd android && gradlew assembleRelease",
        "build:apk:preview": "eas build --platform android --profile preview"
    },
    "dependencies": {
        "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
        "@expo/metro-runtime": "~6.1.2",
        "@expo/vector-icons": "^15.0.3",
        "@hookform/resolvers": "^3.9.1",
        "ajv": "^8.20.0",
        "ajv-keywords": "^5.1.0",
        "expo": "~54.0.0",
        "expo-camera": "~17.0.10",
        "expo-constants": "~18.0.13",
        "expo-crypto": "~15.0.9",
        "expo-font": "~14.0.12",
        "expo-linking": "~8.0.12",
        "expo-local-authentication": "~17.0.8",
        "expo-router": "~6.0.24",
        "expo-secure-store": "~15.0.8",
        "expo-splash-screen": "~31.0.13",
        "expo-sqlite": "~16.0.10",
        "expo-status-bar": "~3.0.9",
        "expo-system-ui": "~6.0.9",
        "expo-updates": "~29.0.19",
        "nativewind": "^4.1.23",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-hook-form": "^7.54.2",
        "react-native": "0.81.5",
        "react-native-gesture-handler": "~2.28.0",
        "react-native-reanimated": "~4.1.1",
        "react-native-safe-area-context": "~5.6.0",
        "react-native-screens": "~4.16.0",
        "react-native-web": "^0.21.0",
        "react-native-worklets": "0.5.1",
        "zod": "^3.24.1",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/jest": "29.5.14",
        "@types/react": "~19.1.10",
        "babel-plugin-inline-import": "^3.0.0",
        "better-sqlite3": "^12.11.1",
        "eslint": "^8.57.0",
        "eslint-config-expo": "~10.0.0",
        "eslint-config-prettier": "^9.1.0",
        "jest": "~29.7.0",
        "jest-expo": "~54.0.0",
        "prettier": "^3.3.3",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.3.3"
    }
}

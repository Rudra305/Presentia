{
    "expo": {
        "name": "Presentia",
        "slug": "presentia",
        "sdkVersion": "54.0.0",
        "version": "1.0.0",
        "runtimeVersion": {
            "policy": "appVersion"
        },
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "presentia",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.rudra.presentia",
            "buildNumber": "1",
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "package": "com.rudra.presentia",
            "versionCode": 1,
            "adaptiveIcon": {
                "backgroundColor": "#0B1220",
                "foregroundImage": "./assets/images/android-icon-foreground.png"
            },
            "predictiveBackGestureEnabled": true,
            "permissions": [
                "android.permission.USE_BIOMETRIC",
                "android.permission.USE_FINGERPRINT",
                "android.permission.CAMERA"
            ]
        },
        "web": {
            "bundler": "metro",
            "output": "single",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#0B1220",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 96,
                    "resizeMode": "contain"
                }
            ],
            [
                "expo-local-authentication",
                {
                    "faceIDPermission": "Allow Presentia to use Face ID to sign in securely."
                }
            ],
            [
                "expo-camera",
                {
                    "cameraPermission": "Allow Presentia to access Camera for real-time face attendance recognition."
                }
            ],
            "expo-secure-store",
            "expo-sqlite",
            "expo-font"
        ],
        "experiments": {
            "typedRoutes": true
        },
        "extra": {
            "eas": {
                "projectId": "3d755f8e-7287-4451-8507-369b5d9be718"
            },
            "router": {}
        }
    }
}
